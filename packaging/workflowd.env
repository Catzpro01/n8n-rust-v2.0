# SPDX-License-Identifier: AGPL-3.0-or-later
# Keep the private editor loopback-only unless an owner deliberately changes ingress.
WORKFLOWD_BIND=127.0.0.1:8787
WORKFLOWD_STATE_DIR=/var/lib/workflow-rust

# Draft editing authority and bounded history defaults.
WORKFLOWD_DRAFT_LEASE_TTL_SECONDS=30
WORKFLOWD_DRAFT_TAKEOVER_GRACE_SECONDS=10
WORKFLOWD_DRAFT_SNAPSHOT_INTERVAL=16
WORKFLOWD_DRAFT_HISTORY_LIMIT=64
WORKFLOWD_DRAFT_UNDO_LIMIT=32
